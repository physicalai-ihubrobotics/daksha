# table has 8 rows, not 16.
GAIN_NODE = "/teach_mode_node"
GAIN_NUM_MOTORS = 8
GAIN_MOTOR_IDS = list(range(1, GAIN_NUM_MOTORS + 1))
# Published by gen2/battery_info.py: a std_msgs/Float32 battery percentage
