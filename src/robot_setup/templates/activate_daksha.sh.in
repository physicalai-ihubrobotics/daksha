# Daksha robot environment. Generated by robot_setup/scripts/install.sh.
# Re-run install.sh to regenerate, uninstall.sh to remove. Don't edit by hand.
#
#     source ~/activate_daksha.sh

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    echo "activate_daksha.sh must be sourced:  source ${BASH_SOURCE[0]}" >&2
    exit 1
fi

_DAKSHA_ROS_SETUP="@ROS_SETUP@"
_DAKSHA_VENV="@VENV@"
_DAKSHA_WS="@WS@"

# Snapshot the path variables this script (and the sourcing it does) changes,
# so deactivate_daksha can put the shell back exactly as it was. Only on the
# first activation - re-sourcing must not overwrite the original values.
_DAKSHA_VARS="PATH PYTHONPATH LD_LIBRARY_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH ROS_PACKAGE_PATH PKG_CONFIG_PATH"
if [ -z "${_DAKSHA_ACTIVE:-}" ]; then
    for _v in $_DAKSHA_VARS; do
        if [ -n "${!_v+x}" ]; then
            printf -v "_DAKSHA_OLD_$_v" '%s' "${!_v}"
            printf -v "_DAKSHA_HAD_$_v" '1'
        else
            unset "_DAKSHA_HAD_$_v"
        fi
    done
    _DAKSHA_ACTIVE=1
fi

source "$_DAKSHA_ROS_SETUP"
source "$_DAKSHA_VENV/bin/activate"

if [ -f "$_DAKSHA_WS/install/setup.bash" ]; then
    source "$_DAKSHA_WS/install/setup.bash"
else
    echo "warning: $_DAKSHA_WS/install/setup.bash not found - run colcon build in $_DAKSHA_WS" >&2
fi

# Put the venv's packages FIRST on PYTHONPATH, after everything else is sourced:
#  - ROS ships its own eigenpy (built for numpy 1.x) in /opt/ros. If it is
#    found before placo's eigenpy, `import placo` fails or segfaults.
#  - placo is a cmeel wheel: its modules live under cmeel.prefix/, registered
#    by a .pth file, and .pth files are ignored for PYTHONPATH entries - so
#    that directory is added explicitly.
#  - Nodes started by `ros2 run` / `ros2 launch` usually run under
#    /usr/bin/python3, not the venv's python; PYTHONPATH reaches them too.
_DAKSHA_SITE="$("$_DAKSHA_VENV/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
_DAKSHA_PYVER="$("$_DAKSHA_VENV/bin/python" -c 'import sys; print(f"python{sys.version_info[0]}.{sys.version_info[1]}")')"
for _p in "$_DAKSHA_SITE" "$_DAKSHA_SITE/cmeel.prefix/lib/$_DAKSHA_PYVER/site-packages"; do
    [ -d "$_p" ] || continue
    # Drop it if already present, then prepend, so re-sourcing keeps it first.
    PYTHONPATH=":${PYTHONPATH}:"; PYTHONPATH="${PYTHONPATH//:$_p:/:}"
    PYTHONPATH="${PYTHONPATH#:}"; PYTHONPATH="${PYTHONPATH%:}"
    export PYTHONPATH="${_p}${PYTHONPATH:+:$PYTHONPATH}"
done

# Same problem one level down: ROS puts /opt/ros/<distro>/lib on
# LD_LIBRARY_PATH, so the dynamic linker loads ROS's libeigenpy.so for
# placo.so ("undefined symbol: EIGENPY_ARRAY_API..."). Put placo's own
# native libs first. Their runtime sonames don't collide with ROS/system ones
# (boost 1.90, assimp 6, tinyxml2 11; qhull is the same 8.0.2).
_p="$_DAKSHA_SITE/cmeel.prefix/lib"
if [ -d "$_p" ]; then
    LD_LIBRARY_PATH=":${LD_LIBRARY_PATH}:"; LD_LIBRARY_PATH="${LD_LIBRARY_PATH//:$_p:/:}"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH#:}"; LD_LIBRARY_PATH="${LD_LIBRARY_PATH%:}"
    export LD_LIBRARY_PATH="${_p}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

echo "================================"
echo " DAKSHA ROBOT ENVIRONMENT"
echo "================================"
echo "Python:      $(command -v python)"
echo "Environment: $VIRTUAL_ENV"
echo "ROS:         $ROS_DISTRO"
echo "Workspace:   $_DAKSHA_WS"
echo "Leave with:  deactivate_daksha     Remove with: daksha_uninstall"

# Undo this script: leave the venv and restore the snapshotted path variables
# (plain `deactivate` only undoes the venv, not PYTHONPATH/LD_LIBRARY_PATH or
# the workspace). Works even after the venv directory has been deleted.
deactivate_daksha() {
    if [ -z "${_DAKSHA_ACTIVE:-}" ]; then
        echo "Daksha environment is not active"
        return 0
    fi
    if declare -F deactivate >/dev/null; then
        deactivate
    fi
    local _v _h _o
    for _v in $_DAKSHA_VARS; do
        _h="_DAKSHA_HAD_$_v"; _o="_DAKSHA_OLD_$_v"
        if [ -n "${!_h:-}" ]; then
            export "$_v=${!_o}"
        else
            unset "$_v"
        fi
        unset "$_h" "$_o"
    done
    unset _DAKSHA_ACTIVE
    hash -r
    echo "Daksha environment deactivated"
}

# Uninstall and leave the environment in one step. A script can't change the
# shell that runs it, so uninstall.sh alone can't deactivate; this function,
# being part of your shell, can.
daksha_uninstall() {
    DAKSHA_DEACTIVATES_AFTER=1 "@WS@/src/robot_setup/scripts/uninstall.sh" "$@" || return
    deactivate_daksha
    unset -f deactivate_daksha daksha_uninstall
}

unset _DAKSHA_ROS_SETUP _DAKSHA_VENV _DAKSHA_WS _DAKSHA_SITE _DAKSHA_PYVER _p _v
