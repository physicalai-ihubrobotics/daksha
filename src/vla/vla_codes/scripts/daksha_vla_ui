#!/usr/bin/env python3

import os
import sys
from pathlib import Path


project_root = Path(os.environ.get("DAKSHA_PROJECT_ROOT", "")).expanduser()
if not project_root.is_absolute() or not (project_root / "app.py").is_file():
    raise SystemExit(
        "Set DAKSHA_PROJECT_ROOT to the lerobot_2 checkout containing app.py, ui/, and lerobot/."
    )

# Run under the workspace environment (~/uni/daksha/robot_venv, created by the
# workspace setup_env.sh), the way `source env.sh` would, in case the launch was started
# from a shell without it; app.py's sys.executable is then the venv python, so
# training/inference subprocesses inherit it too. DAKSHA_VENV overrides the location.
venv_dir = Path(os.environ.get("DAKSHA_VENV") or next(
    (p / "robot_venv" for p in project_root.resolve().parents if (p / "robot_venv").is_dir()),
    project_root / "robot_venv",
))
venv_python = venv_dir / "bin" / "python"
if venv_python.is_file() and Path(sys.prefix).resolve() != venv_dir.resolve():
    os.environ["VIRTUAL_ENV"] = str(venv_python.parent.parent)
    os.environ["PATH"] = f"{venv_python.parent}{os.pathsep}{os.environ.get('PATH', '')}"
    os.execv(str(venv_python), [str(venv_python), __file__, *sys.argv[1:]])

sys.path.insert(0, str(project_root.resolve()))

from app import main


main()
