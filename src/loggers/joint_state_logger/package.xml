<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>joint_state_logger</name>
  <version>0.0.1</version>
  <description>Logs /joint_states (position/velocity/effort), motor_status (mos_temp/rotor_temp) and gesture_status into per-session Parquet files, with CSV fallback and a web control panel (start/stop/new session, record toggles, replay trigger, timeline graphs).</description>
  <maintainer email="selvambharani100@gmail.com">baranidharan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>hw_interface</exec_depend>
  <exec_depend>python3-pyarrow</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <!-- web control panel: replay trigger + record toggles -->
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>gesture_management</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
